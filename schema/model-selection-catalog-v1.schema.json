{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pi:model-selection-catalog:v1",
  "title": "Pi Model Selection Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalog", "variants"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalog": { "$ref": "#/$defs/catalog" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variant" }
    }
  },
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "generatedAt",
        "sourceUpdatedAt",
        "distribution",
        "metricDefinitions",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sourceUpdatedAt": { "type": ["string", "null"], "format": "date-time" },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "termsUrl", "attribution", "allowRedistribution"],
          "properties": {
            "classification": { "enum": ["restricted", "redistributable"] },
            "termsUrl": { "type": ["string", "null"], "format": "uri" },
            "attribution": { "type": ["string", "null"] },
            "allowRedistribution": { "type": "boolean" }
          }
        },
        "metricDefinitions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart", "fast", "cheap"],
          "properties": {
            "smart": { "$ref": "#/$defs/metricHigher" },
            "fast": { "$ref": "#/$defs/metricLower" },
            "cheap": { "$ref": "#/$defs/metricLower" }
          }
        },
        "provenance": { "type": "object" }
      }
    },
    "metricHigher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "better", "task", "methodologyUrl"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "better": { "const": "higher" },
        "task": { "type": "string", "minLength": 1 },
        "methodologyUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "metricLower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "better", "task", "methodologyUrl"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "better": { "const": "lower" },
        "task": { "type": "string", "minLength": 1 },
        "methodologyUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "creator",
        "displayName",
        "checkpoint",
        "quantization",
        "reasoning",
        "metrics",
        "aliases",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "creator": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "checkpoint": { "type": ["string", "null"] },
        "quantization": { "type": ["string", "null"] },
        "reasoning": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["label"],
              "properties": { "label": { "type": "string", "minLength": 1 } }
            }
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["smart", "fast", "cheap"],
          "properties": {
            "smart": { "type": "number" },
            "fast": { "type": "number", "minimum": 0 },
            "cheap": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/alias" }
        },
        "provenance": { "type": "object" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelId", "piThinkingLevel", "equivalence"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 },
        "piThinkingLevel": {
          "type": ["string", "null"],
          "enum": [null, "off", "minimal", "low", "medium", "high", "xhigh", "max"]
        },
        "equivalence": { "const": "verified" }
      }
    }
  }
}
